{
  "name": "microfrontend-one-backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/microfrontend-one-backend/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{workspaceRoot}/dist/apps/microfrontend-one-backend"
      ],
      "options": {
        "outputPath": "dist/apps/microfrontend-one-backend",
        "main": "apps/microfrontend-one-backend/src/main.ts",
        "tsConfig": "apps/microfrontend-one-backend/tsconfig.app.json",
        "assets": [
          "apps/microfrontend-one-backend/src/assets"
        ],
        "generatePackageJson": true,
        "platform": "node",
        "outputFileName": "bundle.js",
        "bundle": true,
        "format": ["cjs"],
        "external": [],
        "esbuildOptions": {
          "outExtension": { ".js": ".js" }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/microfrontend-one-backend/package.json",
        "{workspaceRoot}/dist/apps/microfrontend-one-backend/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/microfrontend-one-backend/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "microfrontend-one-backend:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "microfrontend-one-backend:build:development"
        },
        "production": {
          "buildTarget": "microfrontend-one-backend:build:production"
        }
      }
    }
  },
  "tags": []
}
