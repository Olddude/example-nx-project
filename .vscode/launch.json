{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug microfrontend-one-bff with Nx",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "microfrontend-one-bff"],
      "env": {
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/microfrontend-one-bff/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug shell-bff with Nx",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "shell-bff"],
      "env": {
        "NODE_OPTIONS": "--inspect=9230"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/shell-bff/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    }
  ]
}
