{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "shell-backend",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "serve",
        "shell-backend"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin",
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/shell-backend/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "microfrontend-one-backend",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "serve",
        "microfrontend-one-backend"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin",
        "NODE_OPTIONS": "--inspect=9230"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/microfrontend-one-backend/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    }
  ]
}
